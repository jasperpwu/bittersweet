# Copy to .env.local and fill in from the Expo app's .env — same Supabase
# project, same RLS, same auth. Vite only exposes vars prefixed with VITE_.
#
#   VITE_SUPABASE_URL             = EXPO_PUBLIC_SUPABASE_URL
#   VITE_SUPABASE_PUBLISHABLE_KEY = EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#
# The publishable (anon) key is safe in a client bundle — every table this app
# touches is RLS'd on auth.uid(). Never put a service-role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
