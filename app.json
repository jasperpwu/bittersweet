{
  "expo": {
    "name": "bittersweet-mobile",
    "slug": "bittersweet-mobile",
    "version": "1.0.0",
    "scheme": "bittersweet-mobile",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-dev-client",
      "expo-localization",
      "expo-web-browser",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Bittersweet reads your completed workouts so they can show up as focus sessions.",
          "NSHealthUpdateUsageDescription": "Bittersweet requires this permission to access HealthKit. The app only reads your completed workouts and does not write any data to Health.",
          "background": false
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "WFHA987U5W",
          "appGroup": "group.com.path2us.bittersweet.appblocker",
          "copyToTargetFolder": false
        }
      ],
      [
        "expo-live-activity",
        {
          "enablePushNotifications": true,
          "appGroupIdentifier": "group.com.path2us.bittersweet.appblocker"
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.383580120267-6a7bkendofi4gv78g45nl97n4ftchu54"
        }
      ],
      "expo-iap",
      "./plugins/withFmtFix",
      "./plugins/withHomeWidget",
      "./plugins/withSiriShortcutsRefresh",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0",
            "extraPods": [
              { "name": "GoogleUtilities", "modular_headers": true },
              { "name": "RecaptchaInterop", "modular_headers": true }
            ]
          }
        }
      ],
      [
        "crisp-sdk-react-native",
        {
          "websiteId": "cd116fcd-5d88-476c-8051-06566eea723a"
        }
      ],
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "contact-developer",
              "title": "👋 Contact developer",
              "subtitle": "We are here to help!",
              "icon": "symbol:message.fill"
            }
          ]
        }
      ],
      "./plugins/withDeviceOrientations"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5E6D3"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "deploymentTarget": "18.0",
      "appleTeamId": "WFHA987U5W",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#F5E6D3",
        "dark": {
          "image": "./assets/splash-dark.png",
          "resizeMode": "contain",
          "backgroundColor": "#1B1C30"
        }
      },
      "bundleIdentifier": "com.path2us.bittersweet",
      "infoPlist": {
        "CFBundleDisplayName": "Bittersweet",
        "CFBundleLocalizations": ["en", "de", "es", "fr", "ja", "ko", "pt-BR", "zh-Hans"],
        "NSFamilyControlsUsageDescription": "This app uses Family Controls to help you manage app usage and focus time by blocking selected apps during work sessions.",
        "NSPhotoLibraryUsageDescription": "Bittersweet uses your photo library to let you attach photos to focus session summaries.",
        "NSCameraUsageDescription": "Bittersweet uses the camera to let you take photos for focus session summaries.",
        "NSMotionUsageDescription": "Bittersweet reads motion activity to estimate how focused a session was and suggest a rating.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#f1f1f1"
      },
      "package": "com.path2us.bittersweet"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4445cb0e-e9b4-4970-a6c8-9ad2534ea765"
      }
    },
    "owner": "bittersweet-mobile"
  }
}
