# Copy to .posthog.env (gitignored) and fill in. Used only by the local
# PostHog setup script — never bundled into the app.
#
# Create a SCOPED personal API key in PostHog:
#   Settings → Personal API keys → Create
#   Scopes: cohort (write), insight (write), dashboard (write), + project read
POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# US cloud: https://us.posthog.com   EU cloud: https://eu.posthog.com
POSTHOG_HOST=https://us.posthog.com

# Optional — the script auto-discovers your project if omitted.
# POSTHOG_PROJECT_ID=123456
